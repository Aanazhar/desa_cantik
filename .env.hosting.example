APP_NAME="Desa Cantik"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://domain-anda.tld

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

LOG_CHANNEL=stack
LOG_STACK=single
